// FieldSync — Production Prisma Schema
// Offline-First Field Issue Reporting & Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FIELD_WORKER
  COORDINATOR
  ADMIN
}

enum ReportCategory {
  WATER
  EQUIPMENT
  ELECTRICAL
  INFRASTRUCTURE
  SAFETY
  SERVICE_INTERRUPTION
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkflowStatus {
  DRAFT
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum SyncStatus {
  PENDING
  SYNCHRONIZED
  FAILED
}

model User {
  id           String    @id @default(uuid())
  fullName     String
  email        String    @unique
  passwordHash String
  role         Role      @default(FIELD_WORKER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relationships
  reportsCreated  Report[]        @relation("ReportCreator")
  reportsAssigned Report[]        @relation("ReportAssignee")
  historyActions  ReportHistory[] @relation("HistoryActor")

  @@index([role])
  @@index([email])
  @@map("users")
}

model Report {
  id              String         @id @default(uuid())
  clientId        String?        @unique // Unique client-generated UUID for offline idempotency
  title           String
  description     String
  category        ReportCategory
  location        String         // Human-readable location / landmark
  latitude        Float?
  longitude       Float?
  priority        Priority       @default(MEDIUM)
  status          WorkflowStatus @default(SUBMITTED)
  
  // Sync-related server metadata
  clientCreatedAt DateTime?
  clientUpdatedAt DateTime?
  lastSyncedAt    DateTime?      @default(now())
  syncAttempts    Int            @default(0)
  syncError       String?
  syncStatus      SyncStatus     @default(SYNCHRONIZED)

  // Relationships
  createdById     String
  createdBy       User           @relation("ReportCreator", fields: [createdById], references: [id])
  
  assignedToId    String?
  assignedTo      User?          @relation("ReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  submittedAt     DateTime?      @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  history         ReportHistory[]
  attachments     ReportAttachment[]
  syncEvents      SyncEvent[]

  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdById])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([clientId])
  @@map("reports")
}

model ReportHistory {
  id            String    @id @default(uuid())
  reportId      String
  report        Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         User?     @relation("HistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  action        String    // e.g. "REPORT_CREATED", "STATUS_UPDATED", "COORDINATOR_ASSIGNED", "SYNC_PROCESSED"
  previousValue String?
  newValue      String?
  description   String
  createdAt     DateTime  @default(now())

  @@index([reportId])
  @@index([actorId])
  @@index([createdAt])
  @@map("report_history")
}

model ReportAttachment {
  id          String   @id @default(uuid())
  reportId    String
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fileName    String
  fileType    String
  fileSize    Int
  storagePath String
  createdAt   DateTime @default(now())

  @@index([reportId])
  @@map("report_attachments")
}

model SyncEvent {
  id        String   @id @default(uuid())
  reportId  String?
  report    Report?  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  eventType String   // e.g. "CLIENT_PUSH", "RETRY_ATTEMPT", "CONFLICT_DETECTED"
  status    String   // e.g. "SUCCESS", "PENDING", "FAILED"
  message   String?
  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([createdAt])
  @@map("sync_events")
}
