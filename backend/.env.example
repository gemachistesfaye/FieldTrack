# Application
NODE_ENV=development
PORT=5000

# Database (PostgreSQL - Local or Supabase)
# Format (Supabase Pooler): postgresql://postgres.[REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fieldsync?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fieldsync?schema=public"

# Authentication & Security
JWT_SECRET="replace-with-a-secure-random-secret-key-in-production"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"

# Logging
LOG_LEVEL="info"
